# LREACH Hub（lreach_hub）の接続文字列。予約の読み取りと interview_bookings への登録に使う
# Supabase > Project Settings > Database > Connection string（Transaction pooler, 6543）
HUB_DATABASE_URL=postgresql://postgres.etfnbkrneepqkgdnpmru:PASSWORD@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres
# 共有保存先（ohno_project）の接続文字列。desk_* テーブルと tossup_info
DESK_DATABASE_URL=postgresql://postgres.xgfhmyuvdtwbqjtyumre:PASSWORD@aws-0-ap-southeast-2.pooler.supabase.com:6543/postgres
# ログインのセッション署名用。32文字以上のランダムな文字列（openssl rand -hex 32）
SESSION_SECRET=
# Googleログイン（Google Cloud Console の OAuth クライアントID・ウェブアプリケーション）
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 公開URL（リダイレクトURIは APP_BASE_URL/api/auth/google/callback）
APP_BASE_URL=http://localhost:3100
# 0 にするとパスワードでのログインを止め、Googleログインだけにする
PASSWORD_LOGIN=1
# 1 にすると interview_bookings に書き込まず、登録内容の確認だけにする（本番前の確認用）
HUB_WRITE_DISABLED=0
